      if (!state.discussions) state.discussions = [];
      state.discussions.unshift({
        id: Date.now(),
        author: state.user.handle || 'cherry_reader',
        book,
        text,
        likes: 1,
        comments: []
      });

      saveState();
      renderDiscussions();
      closeNewPostModal();
      addPetExp(10);

      if (bookInput) bookInput.value = '';
      if (textInput) textInput.value = '';
    }

    async function autoFetchBookData() {
      const input = document.getElementById('wish-auto-link-input');
      if (!input) return;
      const query = input.value.trim();
      if (!query) return;

      const previewBox = document.getElementById('auto-fetched-preview');
      const titleEl = document.getElementById('auto-fetched-title');
      const authorEl = document.getElementById('auto-fetched-author');
      const genreEl = document.getElementById('auto-fetched-genre');
      const priceEl = document.getElementById('auto-fetched-price');
      const coverEl = document.getElementById('auto-fetched-cover');

      try {
        const res = await fetch(`https://openlibrary.org/search.json?q=${encodeURIComponent(query)}&limit=1`);
        const data = await res.json();
        if (data.docs && data.docs.length > 0) {
          const doc = data.docs[0];
          fetchedTempBook = {
            id: Date.now(),
            title: doc.title || query,
            author: doc.author_name ? doc.author_name[0] : "Невідомий автор",
            genre: doc.subject ? doc.subject[0] : "Dark Academia",
            price: `${350 + Math.floor(Math.random() * 250)} ₴`,
            cover: doc.cover_i ? `https://covers.openlibrary.org/b/id/${doc.cover_i}-M.jpg` : "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=400&q=80",
            desc: "Автоматично завантажено з Open Library.",
            reservedBy: null
          };

          if (titleEl) titleEl.innerText = fetchedTempBook.title;
          if (authorEl) authorEl.innerText = `by ${fetchedTempBook.author}`;
          if (genreEl) genreEl.innerText = fetchedTempBook.genre;
          if (priceEl) priceEl.innerText = fetchedTempBook.price;
          if (coverEl) coverEl.src = fetchedTempBook.cover;
          if (previewBox) previewBox.classList.remove('hidden');
        } else {
          throw new Error('Not found');
        }
      } catch (err) {
        fetchedTempBook = {
          id: Date.now(),
          title: query,
          author: "Книжковий автор",
          genre: "Fantasy & Romance",
          price: "420 ₴",
          cover: "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=400&q=80",
          desc: "Додано за посиланням.",
          reservedBy: null
        };
        if (titleEl) titleEl.innerText = fetchedTempBook.title;
        if (authorEl) authorEl.innerText = `by ${fetchedTempBook.author}`;
        if (genreEl) genreEl.innerText = fetchedTempBook.genre;
        if (priceEl) priceEl.innerText = fetchedTempBook.price;
        if (coverEl) coverEl.src = fetchedTempBook.cover;
        if (previewBox) previewBox.classList.remove('hidden');
      }
    }

    function saveWishBook() {
      const input = document.getElementById('wish-auto-link-input');
      const query = input ? input.value.trim() : '';
      if (!query && !fetchedTempBook) {
        alert("Будь ласка, введіть посилання або назву книги!");
        return;
      }

      const bookToAdd = fetchedTempBook || {
        id: Date.now(),
        title: query,
        author: "Невідомий автор",
        genre: "Dark Romance",
        price: "390 ₴",
        cover: "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=400&q=80",
        desc: "Додано в бажане.",
        reservedBy: null
      };

      if (!state.wishlist) state.wishlist = [];
      state.wishlist.unshift(bookToAdd);
      saveState();

      renderWishlist();
      renderDedicatedWishlist();
      closeAddWishlistLinkModal();
      fetchedTempBook = null;
      if (input) input.value = '';

      const previewBox = document.getElementById('auto-fetched-preview');
      if (previewBox) previewBox.classList.add('hidden');

      addPetExp(10);
    }

    function moveWishToReadDirect(title, author) {
      if (!state.process) state.process = [];
      state.process.unshift({
        id: Date.now(),
        title: title || 'Книга з вішліста',
        author: author || 'Автор',
        currentPage: 0,
        totalPages: 380,
        cover: 'https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=400&q=80',
        timerSeconds: 0,
        timerActive: false,
        startedAt: new Date().toLocaleString(),
        finishedAt: null,
        sessions: []
      });
      saveState();
      switchTab('process');
    }

    // --- MODAL HANDLERS ---
    function openAddProcessModal() {
      const modal = document.getElementById('add-process-modal');
      if (modal) modal.classList.remove('hidden');
    }

    function closeAddProcessModal() {
      const modal = document.getElementById('add-process-modal');
      if (modal) modal.classList.add('hidden');
    }

    function saveProcessBookModal() {
      const titleInput = document.getElementById('proc-title-input');
      const authorInput = document.getElementById('proc-author-input');
      const totalPagesInput = document.getElementById('proc-total-pages-input');
      const currPagesInput = document.getElementById('proc-curr-pages-input');
      const coverInput = document.getElementById('proc-cover-input');

      const title = titleInput ? titleInput.value.trim() : '';
      const author = authorInput ? authorInput.value.trim() : '';
      const totalPages = totalPagesInput ? parseInt(totalPagesInput.value) || 350 : 350;
      const currentPage = currPagesInput ? parseInt(currPagesInput.value) || 0 : 0;
      const cover = coverInput && coverInput.value.trim() ? coverInput.value.trim() : 'https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=400&q=80';

      if (!title || !author) {
        alert("Заповніть назву книги та автора!");
        return;
      }

      if (!state.process) state.process = [];
      state.process.unshift({
        id: Date.now(),
        title,
        author,
        currentPage,
        totalPages,
        cover,
        timerSeconds: 0,
        timerActive: false,
        startedAt: new Date().toLocaleString(),
        finishedAt: null,
        sessions: []
      });

      saveState();
      renderProcess();
      closeAddProcessModal();
      addPetExp(15);

      if (titleInput) titleInput.value = '';
      if (authorInput) authorInput.value = '';
      if (coverInput) coverInput.value = '';
    }

    function openUpdatePagesModal(id) {
      activeProcessBookId = id;
      const book = state.process.find(b => b.id === id);
      if (!book) return;
      const newPage = prompt(`Оновити сторінку для "${book.title}" (Поточна: ${book.currentPage}):`, book.currentPage);
      if (newPage !== null && !isNaN(newPage)) {
        book.currentPage = Math.min(parseInt(newPage), book.totalPages);
        saveState();
        renderProcess();
        addPetExp(10);
      }
    }

    function openBookStatsModal(id) {
      const book = state.process ? state.process.find(b => b.id === id) : null;
      if (!book) return;

      const modal = document.getElementById('book-stats-modal');
      const titleEl = document.getElementById('stats-modal-title');
      const authorEl = document.getElementById('stats-modal-author');
      const timeEl = document.getElementById('stats-total-time');
      const speedEl = document.getElementById('stats-speed');
      const finishEl = document.getElementById('stats-finish-date');
      const sessionsList = document.getElementById('stats-sessions-list');

      if (titleEl) titleEl.innerText = `📊 ${book.title}`;
      if (authorEl) authorEl.innerText = `by ${book.author}`;

      const totalMins = Math.floor((book.timerSeconds || 0) / 60);
      if (timeEl) timeEl.innerText = `${totalMins} хв`;

      const speed = totalMins > 0 ? Math.round((book.currentPage / totalMins) * 60) : 0;
      if (speedEl) speedEl.innerText = `${speed} стор/год`;
      if (finishEl) finishEl.innerText = `Почато читання: ${book.startedAt || 'Нещодавно'}`;

      if (sessionsList) {
        const sessions = book.sessions || [];
        if (sessions.length === 0) {
          sessionsList.innerHTML = `<p class="text-cherry-400 text-[11px]">Жодної збереженої сесії ще немає.</p>`;
        } else {
          sessionsList.innerHTML = sessions.map(s => `
            <div class="bg-cherry-900/60 p-2 rounded-xl border border-cherry-800 flex justify-between items-center text-[11px]">
              <div><span class="font-bold text-white">${s.startTime || 'Сесія'}</span></div>
              <div class="text-gold-300 font-bold">+${s.pagesRead || 0} стор.</div>
            </div>
          `).join('');
        }
      }

      if (modal) modal.classList.remove('hidden');
    }

    function closeBookStatsModal() {
      const modal = document.getElementById('book-stats-modal');
      if (modal) modal.classList.add('hidden');
    }

    function openCreateLetterModal() {
      renderStarSelectors();
      const modal = document.getElementById('create-letter-modal');
      if (modal) modal.classList.remove('hidden');
    }

    function closeCreateLetterModal() {
      const modal = document.getElementById('create-letter-modal');
      if (modal) modal.classList.add('hidden');
    }

    function saveLetterModal() {
      const titleInput = document.getElementById('letter-title-input');
      const authorInput = document.getElementById('letter-author-input');
      const coverInput = document.getElementById('letter-cover-input');
      const annotationInput = document.getElementById('letter-annotation-input');
      const impressionsInput = document.getElementById('letter-impressions-input');

      const title = titleInput ? titleInput.value.trim() : '';
      const author = authorInput ? authorInput.value.trim() : '';
      const cover = coverInput ? coverInput.value.trim() : '';
      const annotation = annotationInput ? annotationInput.value.trim() : '';
      const impressions = impressionsInput ? impressionsInput.value.trim() : '';

      if (!title || !author) {
        alert("Заповніть назву книги та автора!");
