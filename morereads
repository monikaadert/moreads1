    function toggleTimer(id) {
      const book = state.process ? state.process.find(b => b.id === id) : null;
      if (!book) return;
      book.timerActive = !book.timerActive;
      if (book.timerActive && !book.startedAt) {
        book.startedAt = new Date().toLocaleString();
      }
      saveState();
      renderProcess();
    }

    function startTimerLoop() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        let changed = false;
        if (state.process) {
          state.process.forEach(p => {
            if (p.timerActive) {
              p.timerSeconds = (p.timerSeconds || 0) + 1;
              changed = true;
            }
          });
        }
        if (changed) {
          renderProcess();
        }
      }, 1000);
    }

