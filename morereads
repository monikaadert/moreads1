      renderLetters();
      closeCreateLetterModal();
      addPetExp(20);

      if (titleInput) titleInput.value = '';
      if (authorInput) authorInput.value = '';
      if (coverInput) coverInput.value = '';
      if (annotationInput) annotationInput.value = '';
      if (impressionsInput) impressionsInput.value = '';
    }

    // --- GEMINI AI ASSISTANT ---
    function toggleAssistantModal() {
      const modal = document.getElementById('assistant-modal');
      if (modal) modal.classList.toggle('hidden');
      const keyInput = document.getElementById('gemini-api-key-input');
      if (keyInput && localStorage.getItem('gemini_api_key')) {
        keyInput.value = localStorage.getItem('gemini_api_key');
      }
    }

    function saveGeminiKey() {
      const input = document.getElementById('gemini-api-key-input');
      if (input) {
        localStorage.setItem('gemini_api_key', input.value.trim());
      }
    }

    async function sendAssistantMessage() {
      const input = document.getElementById('assistant-chat-input');
      const chatBox = document.getElementById('assistant-chat-box');
      if (!input || !chatBox) return;

      const userMsg = input.value.trim();
      if (!userMsg) return;

      chatBox.innerHTML += `
        <div class="bg-cherry-950 p-2.5 rounded-xl text-white ml-auto max-w-[85%] border border-cherry-700">
          <span class="font-bold text-cherry-300">Ви:</span> ${userMsg}
        </div>
      `;
      input.value = '';
      chatBox.scrollTop = chatBox.scrollHeight;

      const apiKey = localStorage.getItem('gemini_api_key');
      if (apiKey) {
        try {
          const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{ parts: [{ text: `Ви - Madeline, вишуканий книжковий помічник темного академічного клубу. Відповідайте вишукано українською мовою: ${userMsg}` }] }]
            })
          });
          const data = await res.json();
          const aiReply = data.candidates?.[0]?.content?.parts?.[0]?.text || "Вибачте, виникла помилка під час відповіді Gemini.";
          chatBox.innerHTML += `
            <div class="bg-cherry-800/60 p-3 rounded-xl text-cherry-100 max-w-[85%] border border-cherry-700/50">
              <span class="font-bold text-gold-300">Madeline:</span> ${aiReply}
            </div>
          `;
        } catch (e) {
          chatBox.innerHTML += `
            <div class="bg-cherry-800/60 p-3 rounded-xl text-cherry-100 max-w-[85%] border border-cherry-700/50">
              <span class="font-bold text-gold-300">Madeline:</span> Чудовий вибір книги! Рекомендую звернути увагу на атмосферу Dark Academia та готичні романи.
            </div>
          `;
        }
      } else {
        setTimeout(() => {
          chatBox.innerHTML += `
            <div class="bg-cherry-800/60 p-3 rounded-xl text-cherry-100 max-w-[85%] border border-cherry-700/50">
              <span class="font-bold text-gold-300">Madeline:</span> Рекомендую звернути увагу на книги "Таємнича історія" Донни Тартт або "Жестокий принц" Голлі Блек! 🍷 (Введіть Gemini Key для живого ШІ).
            </div>
          `;
          chatBox.scrollTop = chatBox.scrollHeight;
        }, 500);
      }
      chatBox.scrollTop = chatBox.scrollHeight;
      addPetExp(5);
    }

    // --- BOOK CHILD VIRTUAL PET LOGIC ---
    function toggleChildDrawer() {
      const drawer = document.getElementById('child-drawer');
      if (drawer) drawer.classList.toggle('translate-x-full');
      updateChildUI();
    }

    function updateChildUI() {
      const nameEl = document.getElementById('child-pet-name');
      const lvlVal = document.getElementById('child-level-val');
      const expVal = document.getElementById('child-exp-val');
      const expBar = document.getElementById('child-exp-bar');
      const badgeLvl = document.getElementById('child-badge-lvl');
      const fatherEl = document.getElementById('child-father-display');
      const chooseFatherBtn = document.getElementById('choose-father-btn');

      if (!state.child) state.child = { name: "Lyra", level: 1, exp: 35, father: null };

      if (nameEl) nameEl.innerText = state.child.name || "Lyra";
      if (lvlVal) lvlVal.innerText = state.child.level || 1;
      if (expVal) expVal.innerText = state.child.exp || 0;
      if (badgeLvl) badgeLvl.innerText = `lvl ${state.child.level || 1}`;
      if (expBar) expBar.style.width = `${Math.min(state.child.exp || 0, 100)}%`;
      if (fatherEl) fatherEl.innerText = state.child.father ? `👑 Батько: ${state.child.father}` : '';

      if (chooseFatherBtn) {
        if ((state.child.level || 1) >= 5 && !state.child.father) {
          chooseFatherBtn.classList.remove('hidden');
        } else {
          chooseFatherBtn.classList.add('hidden');
        }
      }
    }

    function addPetExp(amount) {
      if (!state.child) state.child = { name: "Lyra", level: 1, exp: 0, father: null };
      state.child.exp = (state.child.exp || 0) + amount;
      if (state.child.exp >= 100) {
        state.child.level = (state.child.level || 1) + 1;
        state.child.exp = state.child.exp - 100;
      }
      saveState();
      updateChildUI();
    }

    function changeChildName() {
      const now = new Date();
      if (state.child.lastLastNameChangeDate) {
        const lastDate = new Date(state.child.lastLastNameChangeDate);
        const diffDays = Math.floor((now - lastDate) / (1000 * 60 * 60 * 24));
        if (diffDays < 30) {
          alert(`Ім'я дитяти можна змінювати лише 1 раз на місяць! Залишилося чекати: ${30 - diffDays} дн.`);
          return;
        }
      }

      const newName = prompt("Введіть нове ім'я для Книжкового Дитяти:", state.child.name);
      if (newName && newName.trim()) {
        state.child.name = newName.trim();
        state.child.lastLastNameChangeDate = now.toISOString();
        saveState();
        updateChildUI();
      }
    }

    function openChooseFatherModal() {
      const modal = document.getElementById('choose-father-modal');
      if (modal) modal.classList.remove('hidden');
    }

    function closeChooseFatherModal() {
      const modal = document.getElementById('choose-father-modal');
      if (modal) modal.classList.add('hidden');
    }

    function selectChildFather(fatherName) {
      if (!state.child) state.child = {};
      state.child.father = fatherName;
      saveState();
      updateChildUI();
      closeChooseFatherModal();
    }

    function sendChildMessage() {
      const input = document.getElementById('child-chat-input');
      const box = document.getElementById('child-messages-box');
      if (!input || !box) return;
      const text = input.value.trim();
      if (!text) return;

      box.innerHTML += `<div class="bg-cherry-950 p-1.5 rounded-xl text-white text-[11px]"><span class="font-bold text-cherry-300">Ви:</span> ${text}</div>`;
      input.value = '';

      setTimeout(() => {
        box.innerHTML += `<div class="bg-cherry-800/60 p-1.5 rounded-xl text-cherry-100 text-[11px]"><span class="font-bold text-gold-300">${state.child.name}:</span> Дякую! Давай читати далі! 🍒</div>`;
        box.scrollTop = box.scrollHeight;
      }, 400);
      addPetExp(3);
    }

    // --- AUTH & PROFILE ---
    function toggleAuthModal() {
      const modal = document.getElementById('auth-modal');
      if (modal) modal.classList.toggle('hidden');
    }

    function switchAuthTab(tab) {
      const loginBtn = document.getElementById('auth-tab-login');
      const regBtn = document.getElementById('auth-tab-register');
      if (loginBtn && regBtn) {
        if (tab === 'login') {
          loginBtn.className = "flex-1 py-1.5 rounded-lg text-white bg-cherry-600";
          regBtn.className = "flex-1 py-1.5 rounded-lg text-cherry-300 hover:text-white";
        } else {
          regBtn.className = "flex-1 py-1.5 rounded-lg text-white bg-cherry-600";
          loginBtn.className = "flex-1 py-1.5 rounded-lg text-cherry-300 hover:text-white";
        }
      }
    }

    function loginWithGoogle() {
      alert("Успішний вхід через Google!");
      saveUserProfile();
    }

    function saveUserProfile() {
      const handleInput = document.getElementById('user-handle-input');
      const emojiInput = document.getElementById('user-emoji-input');

      if (!state.user) state.user = {};
      if (handleInput) state.user.handle = handleInput.value.trim() || "cherry_reader";
      if (emojiInput) state.user.emoji = emojiInput.value.trim() || "🌸";

      const display = document.getElementById('user-avatar-display');
      if (display) display.innerText = state.user.emoji;

      saveState();
      toggleAuthModal();
    }

    function openFriendsModal() {
      const modal = document.getElementById('friends-modal');
      const list = document.getElementById('friends-modal-list');
      if (list) {
        list.innerHTML = (state.friends || []).map(f => `
          <div class="bg-cherry-900/60 p-2 rounded-xl flex justify-between items-center text-xs border border-cherry-800">
            <span>${f.emoji || '🌸'} <strong>${f.name}</strong></span>
            <span class="text-cherry-300 text-[10px]">${f.currentBook || 'Читає'}</span>
          </div>
        `).join('');
      }
      if (modal) modal.classList.toggle('hidden');
    }

    function addFriendModal() {
      const input = document.getElementById('new-friend-name-input');
      if (!input) return;
      const name = input.value.trim();
      if (!name) return;

      if (!state.friends) state.friends = [];
      state.friends.push({
        name,
        currentBook: "Нова книга",
        page: 1,
        emoji: "📖",
        likes: 0
      });
      saveState();
      openFriendsModal();
      renderFriendsReadingShelf();
      input.value = '';
    }

    // --- INITIALIZATION ---
    window.onload = function() {
      loadState();
      switchTab('read');
      startTimerLoop();
      updateChildUI();
    };
  </script>
