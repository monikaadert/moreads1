<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>moreads/ - dark cherry book club</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,800;1,400&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            cherry: {
              950: '#140307',
              900: '#23060c',
              800: '#380b15',
              700: '#52101e',
              600: '#75172b',
              500: '#9e1b34',
              400: '#ca2a49',
              300: '#e5536f',
              200: '#f497a9',
              100: '#fbdbe2',
            },
            gold: {
              400: '#f3c77c',
              300: '#fada9d',
            }
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            serif: ['Playfair Display', 'serif'],
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #140307;
      color: #fbdbe2;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .serif { font-family: 'Playfair Display', serif; }
    .cherry-card {
      background: rgba(56, 11, 21, 0.45);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(229, 83, 111, 0.15);
    }
    .cherry-card:hover {
      border-color: rgba(229, 83, 111, 0.35);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #140307;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #52101e;
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #9e1b34;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between custom-scrollbar selection:bg-cherry-500 selection:text-white">

  <!-- HEADER -->
  <header class="sticky top-0 z-40 border-b border-cherry-700/40 bg-cherry-950/90 backdrop-blur-md px-4 lg:px-8 py-3">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      
      <!-- LOGO -->
      <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('read')">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-cherry-700 to-rose-400 p-0.5 shadow-lg flex items-center justify-center">
          <div class="w-full h-full bg-cherry-900 rounded-[14px] flex items-center justify-center text-xl">🍒</div>
        </div>
        <div>
          <h1 class="text-2xl font-bold tracking-tight lowercase text-white flex items-center gap-1">
            moreads<span class="text-cherry-400 font-serif">/</span>
          </h1>
          <p class="text-[10px] text-cherry-300/70 tracking-widest uppercase">dark cherry book realm</p>
        </div>
      </div>

      <!-- NAV TABS -->
      <nav class="hidden md:flex items-center gap-1 bg-cherry-900/60 p-1.5 rounded-2xl border border-cherry-700/30 text-xs">
        <button onclick="switchTab('read')" id="nav-read" class="px-3 py-2 rounded-xl font-semibold transition bg-cherry-600 text-white shadow-md">📚 прочитані</button>
        <button onclick="switchTab('process')" id="nav-process" class="px-3 py-2 rounded-xl font-semibold transition text-cherry-200 hover:text-white hover:bg-cherry-800/50">📖 читаю зараз</button>
        <button onclick="switchTab('want')" id="nav-want" class="px-3 py-2 rounded-xl font-semibold transition text-cherry-200 hover:text-white hover:bg-cherry-800/50">🔖 хочу прочитати</button>
        <button onclick="switchTab('wishlist')" id="nav-wishlist" class="px-3 py-2 rounded-xl font-semibold transition text-cherry-200 hover:text-white hover:bg-cherry-800/50">🎁 вішліст</button>
        <button onclick="switchTab('discussions')" id="nav-discussions" class="px-3 py-2 rounded-xl font-semibold transition text-cherry-200 hover:text-white hover:bg-cherry-800/50">💬 обговорення</button>
      </nav>

      <!-- RIGHT SIDE CONTROLS -->
      <div class="flex items-center gap-2">
        <!-- LANGUAGE SWITCHER -->
        <div class="flex bg-cherry-900 border border-cherry-700/60 rounded-xl p-0.5 text-[10px] font-bold">
          <button onclick="setLanguage('uk')" id="lang-btn-uk" class="px-2 py-1 rounded-lg text-white bg-cherry-600">UA</button>
          <button onclick="setLanguage('en')" id="lang-btn-en" class="px-2 py-1 rounded-lg text-cherry-300 hover:text-white">EN</button>
          <button onclick="setLanguage('de')" id="lang-btn-de" class="px-2 py-1 rounded-lg text-cherry-300 hover:text-white">DE</button>
        </div>

        <!-- AI Assistant Button -->
        <button onclick="toggleAssistantModal()" class="p-2 rounded-xl bg-cherry-800 hover:bg-cherry-700 border border-cherry-600/40 text-white text-xs font-semibold flex items-center gap-1.5 shadow">
          <span>💃</span>
          <span class="hidden sm:inline" data-i18n="ai_assistant">AI Помічник</span>
        </button>

        <!-- Book Child Virtual Pet -->
        <button onclick="toggleChildDrawer()" class="p-2 rounded-xl bg-gradient-to-r from-cherry-800 to-cherry-900 border border-cherry-500/30 text-gold-300 text-xs font-semibold flex items-center gap-1.5 shadow">
          <span>🍒</span>
          <span class="hidden sm:inline" data-i18n="book_child">дитя</span>
          <span id="child-badge-lvl" class="bg-cherry-500 text-white text-[9px] px-1.5 py-0.5 rounded-full font-bold">lvl 1</span>
        </button>

        <!-- Auth / Profile -->
        <button onclick="toggleAuthModal()" class="flex items-center gap-2 bg-cherry-900 border border-cherry-700/50 p-1.5 rounded-xl hover:border-cherry-400 transition">
          <div id="user-avatar-display" class="w-7 h-7 rounded-lg bg-cherry-600 text-white flex items-center justify-center font-bold text-xs">🌸</div>
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="max-w-7xl mx-auto px-4 lg:px-8 py-8 w-full flex-grow">

    <!-- TAB 1: READ BOOKS -->
    <section id="tab-read" class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-cherry-900/30 p-6 rounded-3xl border border-cherry-800/40">
        <div>
          <h2 class="text-3xl font-bold serif text-white flex items-center gap-3">
            <span>💌</span> <span data-i18n="letters_title">мої книжкові листи та враження</span>
          </h2>
          <p class="text-xs text-cherry-300/80 mt-1" data-i18n="letters_sub">створюйте естетичні рецензії з детальною оцінкою категорій</p>
        </div>
        <button onclick="openCreateLetterModal()" class="bg-cherry-500 hover:bg-cherry-400 text-white font-bold px-5 py-3 rounded-2xl shadow-lg transition text-xs flex items-center gap-2">
          <span>✨</span> <span data-i18n="write_letter_btn">написати книжковий лист</span>
        </button>
      </div>

      <div id="letters-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </section>

    <!-- TAB 2: PROCESS -->
    <section id="tab-process" class="hidden space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-cherry-900/30 p-6 rounded-3xl border border-cherry-800/40">
        <div>
          <h2 class="text-3xl font-bold serif text-white flex items-center gap-3">
            <span>📖</span> <span data-i18n="process_title">у процесі читання</span>
          </h2>
          <p class="text-xs text-cherry-300/80 mt-1" data-i18n="process_sub">відстежуйте прочитані сторінки, таймер читання, швидкість та історію сесій</p>
        </div>
        <button onclick="openAddProcessModal()" class="bg-cherry-600 hover:bg-cherry-500 text-white font-bold px-4 py-2.5 rounded-2xl text-xs flex items-center gap-2 transition">
          <span>➕</span> <span data-i18n="add_book_btn">додати книгу</span>
        </button>
      </div>

      <!-- FRIENDS READING NOW SHELF -->
      <div class="bg-cherry-950/60 p-5 rounded-3xl border border-cherry-800/60 space-y-3">
        <h3 class="text-sm font-bold text-gold-300 lowercase flex items-center gap-2">
          <span>👥</span> <span data-i18n="friends_reading_title">що зараз читають мої друзі</span>
        </h3>
        <div id="friends-reading-shelf" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
          <!-- Dynamic friends current reads -->
        </div>
      </div>

      <div id="process-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6"></div>
    </section>

    <!-- TAB 3: WANT TO READ -->
    <section id="tab-want" class="hidden space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-cherry-900/30 p-6 rounded-3xl border border-cherry-800/40">
        <div>
          <h2 class="text-3xl font-bold serif text-white flex items-center gap-3">
            <span>🔖</span> <span data-i18n="want_title">хочу прочитати</span>
          </h2>
          <p class="text-xs text-cherry-300/80 mt-1" data-i18n="want_sub">список збережених книг для затишних вечорів</p>
        </div>
        <button onclick="openAddWishModal()" class="bg-cherry-600 hover:bg-cherry-500 text-white font-bold px-4 py-2.5 rounded-2xl text-xs flex items-center gap-2 transition">
          <span>📌</span> <span data-i18n="add_wish_btn">додати у бажане</span>
        </button>
      </div>

      <div id="wishlist-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"></div>
    </section>

    <!-- TAB 3.5: DEDICATED WISHLIST TAB -->
    <section id="tab-wishlist" class="hidden space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-cherry-900/30 p-6 rounded-3xl border border-cherry-800/40">
        <div>
          <h2 class="text-3xl font-bold serif text-white flex items-center gap-3">
            <span>🎁</span> <span data-i18n="wishlist_title">мій вішліст & вішлісти друзів</span>
          </h2>
          <p class="text-xs text-cherry-300/80 mt-1" data-i18n="wishlist_sub">вставте посилання або назву книги — вся інформація підтягнеться автоматично!</p>
        </div>
        <button onclick="openAddWishlistLinkModal()" class="bg-gradient-to-r from-cherry-500 to-rose-500 hover:from-cherry-400 hover:to-rose-400 text-white font-bold px-5 py-3 rounded-2xl shadow-lg transition text-xs flex items-center gap-2">
          <span>🔗</span> <span data-i18n="add_wish_link_btn">додати книгу за посиланням</span>
        </button>
      </div>

      <!-- SELECT FRIEND WISHLIST VIEW -->
      <div class="flex items-center gap-3 bg-cherry-950/80 p-4 rounded-2xl border border-cherry-800">
        <span class="text-xs font-bold text-gold-300 uppercase" data-i18n="wishlist_profile_label">👥 Перегляд профілю / вішліста:</span>
        <select id="friend-wishlist-select" onchange="changeWishlistOwnerView()" class="bg-cherry-900 border border-cherry-700 text-white text-xs rounded-xl px-3 py-1.5 focus:outline-none focus:border-cherry-400">
          <option value="my">🌸 Мій власний вішліст</option>
        </select>
      </div>

      <div id="dedicated-wishlist-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"></div>
    </section>

    <!-- TAB 4: DISCUSSIONS -->
    <section id="tab-discussions" class="hidden space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-cherry-900/30 p-6 rounded-3xl border border-cherry-800/40">
        <div>
          <h2 class="text-3xl font-bold serif text-white flex items-center gap-3">
            <span>💬</span> <span data-i18n="discussions_title">салон обговорень</span>
          </h2>
          <p class="text-xs text-cherry-300/80 mt-1" data-i18n="discussions_sub">діліться думками та коментуйте дописи інших читачів</p>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="openFriendsModal()" class="bg-cherry-800 hover:bg-cherry-700 text-white px-4 py-2.5 rounded-2xl text-xs font-semibold flex items-center gap-1.5">
            👥 <span data-i18n="my_friends_btn">мої друзі</span>
          </button>
          <button onclick="openNewPostModal()" class="bg-cherry-500 hover:bg-cherry-400 text-white font-bold px-4 py-2.5 rounded-2xl text-xs flex items-center gap-2 shadow transition">
            <span>✍️</span> <span data-i18n="create_thread_btn">створити тему</span>
          </button>
        </div>
      </div>

      <!-- FEED CONTAINER -->
      <div id="discussions-feed" class="space-y-4"></div>
    </section>
  </main>
  <!-- ADD NEW DISCUSSION THREAD MODAL -->
  <div id="add-discussion-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="bg-cherry-950 border border-cherry-700 rounded-3xl w-full max-w-md p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-cherry-800 pb-3">
        <h3 class="text-lg font-bold text-white serif lowercase flex items-center gap-2">
          <span>✍️</span> Створити нову тему
        </h3>
        <button onclick="closeNewPostModal()" class="text-cherry-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <div class="space-y-3 text-xs">
        <div>
          <label class="block text-cherry-300 mb-1 font-semibold">Назва книги / Тема *</label>
          <input type="text" id="disc-book-title-input" placeholder="e.g. Фінал книги 'Жестокий принц'" class="w-full bg-cherry-900 border border-cherry-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cherry-400">
        </div>
        <div>
          <label class="block text-cherry-300 mb-1 font-semibold">Ваш допис / Запитання *</label>
          <textarea id="disc-text-input" rows="4" placeholder="Поділіться своїми враженнями або поставте запитання спільноті..." class="w-full bg-cherry-900 border border-cherry-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cherry-400"></textarea>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-2 border-t border-cherry-800">
        <button onclick="closeNewPostModal()" class="px-4 py-2 bg-cherry-900 text-cherry-200 rounded-xl text-xs" data-i18n="cancel_btn">скасувати</button>
        <button onclick="saveNewDiscussionThread()" class="px-5 py-2 bg-cherry-500 hover:bg-cherry-400 text-white rounded-xl text-xs font-bold">Опублікувати тему</button>
      </div>
    </div>
  </div>

  <!-- AI COMPANION MODAL -->
  <div id="assistant-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="bg-cherry-950 border border-cherry-700/80 rounded-3xl w-full max-w-lg p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-cherry-800 pb-3">
        <h3 class="text-lg font-bold text-white serif lowercase flex items-center gap-2">
          <span>💃</span> AI Помічник Gemini (Madeline)
        </h3>
        <button onclick="toggleAssistantModal()" class="text-cherry-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <!-- GEMINI API KEY INPUT BAR -->
      <div class="bg-cherry-900/60 p-2.5 rounded-2xl border border-cherry-800 flex items-center gap-2 text-xs">
        <span class="text-gold-300 font-bold shrink-0">🔑 Gemini API Key:</span>
        <input type="password" id="gemini-api-key-input" placeholder="Введіть ваш Gemini Key (або залишіть порожнім)..." onchange="saveGeminiKey()" class="flex-grow bg-cherry-950 border border-cherry-700 rounded-xl px-2.5 py-1 text-white text-[11px] focus:outline-none focus:border-cherry-400">
      </div>

      <!-- CHAT MESSAGES -->
      <div id="assistant-chat-box" class="bg-cherry-900/40 p-4 rounded-2xl border border-cherry-800 h-64 overflow-y-auto custom-scrollbar space-y-3 text-xs">
        <div class="bg-cherry-800/60 p-3 rounded-xl text-cherry-100 max-w-[85%] border border-cherry-700/50">
          <span class="font-bold text-gold-300">Madeline:</span> Вітаю, мій любий читачу! Я працюю на базі **Google Gemini**. Введіть свій ключ або запитуйте про рекомендації книг, аналіз персонажів та естетику читання ☕
        </div>
      </div>

      <!-- INPUT BAR -->
      <div class="flex gap-2 pt-1">
        <input type="text" id="assistant-chat-input" placeholder="Запитати у Gemini помічника..." class="flex-grow bg-cherry-900 border border-cherry-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cherry-400" onkeydown="if(event.key==='Enter') sendAssistantMessage()">
        <button onclick="sendAssistantMessage()" id="send-ai-btn" class="bg-cherry-600 hover:bg-cherry-500 text-white px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1">
          <span>✨</span> Надіслати
        </button>
      </div>
    </div>
  </div>

  <!-- BOOK STATS MODAL -->
  <div id="book-stats-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="bg-cherry-950 border border-cherry-700 rounded-3xl w-full max-w-md p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-cherry-800 pb-3">
        <div>
          <h3 id="stats-modal-title" class="text-lg font-bold text-white serif">📊 Статистика</h3>
          <p id="stats-modal-author" class="text-xs text-cherry-300"></p>
        </div>
        <button onclick="closeBookStatsModal()" class="text-cherry-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <div class="grid grid-cols-2 gap-3 text-xs">
        <div class="bg-cherry-900/60 p-3 rounded-2xl border border-cherry-800">
          <span class="text-[10px] text-cherry-400 font-bold block uppercase">Час у читанні</span>
          <span id="stats-total-time" class="text-base font-bold text-white">0 хв</span>
        </div>
        <div class="bg-cherry-900/60 p-3 rounded-2xl border border-cherry-800">
          <span class="text-[10px] text-cherry-400 font-bold block uppercase">Швидкість</span>
          <span id="stats-speed" class="text-base font-bold text-emerald-400">0 стор/год</span>
        </div>
      </div>

      <div class="text-xs text-cherry-300 bg-cherry-900/30 p-2.5 rounded-xl border border-cherry-800/40">
        📅 <span id="stats-finish-date"></span>
      </div>

      <div class="space-y-2">
        <h4 class="text-xs font-bold text-gold-300 uppercase">Історія сесій</h4>
        <div id="stats-sessions-list" class="space-y-1.5 max-h-40 overflow-y-auto custom-scrollbar text-xs"></div>
      </div>
    </div>
  </div>

  <!-- ADD WISHLIST VIA LINK MODAL -->
  <div id="add-wish-link-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="bg-cherry-950 border border-cherry-700 rounded-3xl w-full max-w-md p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-cherry-800 pb-3">
        <h3 class="text-lg font-bold text-white serif lowercase flex items-center gap-2">
          <span>🔗</span> <span data-i18n="auto_wish_modal_title">авто-додавання книги у вішліст</span>
        </h3>
        <button onclick="closeAddWishlistLinkModal()" class="text-cherry-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="space-y-3 text-xs">
        <div>
          <label class="block text-cherry-300 mb-1 font-semibold" data-i18n="link_input_label">Вставте посилання, ISBN або назву книги *</label>
          <div class="flex gap-2">
            <input type="text" id="wish-auto-link-input" placeholder="e.g. https://... or Cruel Prince" class="flex-grow bg-cherry-900 border border-cherry-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-cherry-400">
            <button onclick="autoFetchBookData()" class="bg-cherry-700 hover:bg-cherry-600 text-white px-3 py-2 rounded-xl font-bold">🔍</button>
          </div>
          <p class="text-[10px] text-cherry-400 mt-1" data-i18n="auto_fetch_hint">Система автоматично знайде обкладинку, автора, жанр та опис!</p>
        </div>

        <!-- FETCH PREVIEW BOX -->
        <div id="auto-fetched-preview" class="hidden bg-cherry-900/50 p-3 rounded-2xl border border-cherry-800 space-y-2">
          <div class="flex items-center gap-3">
            <img id="auto-fetched-cover" src="" class="w-12 h-16 object-cover rounded-lg border border-cherry-700">
            <div>
              <h4 id="auto-fetched-title" class="font-bold text-white text-sm"></h4>
              <p id="auto-fetched-author" class="text-cherry-300 text-[11px]"></p>
              <div class="flex gap-2 text-[10px] mt-1">
                <span id="auto-fetched-genre" class="bg-cherry-800 text-gold-300 px-2 py-0.5 rounded font-bold"></span>
                <span id="auto-fetched-price" class="bg-emerald-950 text-emerald-400 border border-emerald-800 px-2 py-0.5 rounded font-bold"></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-2 border-t border-cherry-800">
        <button onclick="closeAddWishlistLinkModal()" class="px-4 py-2 bg-cherry-900 text-cherry-200 rounded-xl text-xs" data-i18n="cancel_btn">скасувати</button>
